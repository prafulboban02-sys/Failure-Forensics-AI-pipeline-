# Which provider to use: "ollama" (free, local, default) or "anthropic"
LLM_PROVIDER=ollama

# --- Ollama settings (used when LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=llama3.1

# --- Anthropic settings (used when LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=your-key-here
# PIPELINE_MODEL=claude-sonnet-5

# --- Optional: use a DIFFERENT model as the judge (Phase 3 root-cause
# analysis) than the one running the pipeline. Recommended once you have
# an API key: keep the pipeline free on Ollama, but let Claude do the
# judging -- a same-model judge shares the pipeline's blind spots and
# won't catch mistakes it would have made itself.
# JUDGE_LLM_PROVIDER=anthropic
# JUDGE_MODEL=claude-sonnet-5
# (JUDGE_LLM_PROVIDER falls back to LLM_PROVIDER, JUDGE_MODEL falls back
#  to PIPELINE_MODEL, if left unset -- so this is fully optional.)

# --- Phase 7 hardening: how many times to run the judge per step and
# take the median score / majority category (self-consistency), instead
# of trusting a single noisy sample. Default is 3 if unset. Set to 1 to
# disable and match the original single-call behavior (faster, cheaper,
# but reintroduces the noise the calibration report measured -- e.g. the
# currency-mismatch false positives).
# JUDGE_SAMPLES=3
